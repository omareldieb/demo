# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# You can get your Clerk keys from https://clerk.com
# 1. Sign up for a free account at https://clerk.com
# 2. Create a new application
# 3. Copy the publishable key from the dashboard
# 4. Replace 'your_clerk_publishable_key_here' with your actual key